<!DOCTYPE html>
<html lang="th"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>โหวตเดินแบบนักเรียน</title>
<link href="https://fonts.googleapis.com/css2?family=Mali:wght@500;700&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box}
body{font-family:'Mali',sans-serif;margin:0;padding:18px 16px 170px;min-height:100vh;color:#3b2a63;
background:linear-gradient(180deg,#2b2a7a 0%,#6a4bc4 45%,#f6a6d0 100%) fixed}
.stars{position:fixed;inset:0;pointer-events:none;background:
radial-gradient(2px 2px at 12% 18%,#fff,transparent),radial-gradient(2px 2px at 70% 10%,#ffe9a8,transparent),
radial-gradient(3px 3px at 85% 35%,#fff,transparent),radial-gradient(2px 2px at 30% 45%,#ffe9a8,transparent),
radial-gradient(2px 2px at 55% 28%,#fff,transparent),radial-gradient(3px 3px at 8% 60%,#fff,transparent);
animation:tw 3s ease-in-out infinite alternate}
@keyframes tw{from{opacity:.35}to{opacity:1}}
.castle{position:fixed;left:0;right:0;bottom:0;width:100%;height:150px;pointer-events:none;opacity:.55}
h1{font-size:24px;text-align:center;margin:10px 0 4px;color:#fff;text-shadow:0 2px 8px #0006}
.sub{text-align:center;color:#ffe9a8;font-size:15px;margin-bottom:14px}
#app{position:relative;max-width:520px;margin:auto}
.c{background:#fffaf0;border:3px solid #f5c84c;border-radius:22px;padding:14px;margin:12px 0;font-size:18px;font-weight:700;display:flex;gap:12px;align-items:center;box-shadow:0 6px 16px #0003}
.c .n{flex:none;width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,#ffd75e,#f59ac6);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px}
.c span{flex:1}
button{font-family:inherit;font-weight:700;background:linear-gradient(135deg,#ffd75e,#f7a5cf);color:#4a2b7a;border:0;border-radius:999px;padding:10px 18px;font-size:16px;box-shadow:0 3px 0 #c98a2b}
button:active{transform:translateY(2px);box-shadow:0 1px 0 #c98a2b}
button.g{background:#efe9fb;box-shadow:0 3px 0 #bdb0e0;color:#6a4bc4}
.msg{text-align:center;font-size:19px;margin-top:40px;color:#fff;font-weight:700;text-shadow:0 2px 6px #0005;line-height:1.8;white-space:pre-line}
.ov{position:fixed;inset:0;background:#1c1450aa;display:none;align-items:center;justify-content:center;padding:24px;z-index:9;backdrop-filter:blur(3px)}
.md{background:#fffaf0;border:4px solid #f5c84c;border-radius:28px;padding:26px 22px 20px;max-width:340px;width:100%;text-align:center;animation:pop .35s cubic-bezier(.3,1.6,.5,1);box-shadow:0 12px 40px #0006}
@keyframes pop{from{transform:scale(.6);opacity:0}to{transform:scale(1);opacity:1}}
.md .ic{font-size:54px;line-height:1}.md h3{margin:10px 0 4px;font-size:21px}.md p{margin:0 0 16px;font-size:15px;color:#6b5a96;white-space:pre-line}
.bt{display:flex;gap:10px;justify-content:center}.bt button{flex:1}
.sp{position:fixed;bottom:30%;font-size:22px;pointer-events:none;z-index:10;animation:up 1.6s ease-out forwards}
@keyframes up{to{transform:translateY(-260px) rotate(40deg);opacity:0}}
</style></head>
<body>
<div class="stars"></div>
<svg class="castle" viewBox="0 0 400 150" preserveAspectRatio="xMidYMax slice"><g fill="#3a2a86">
<rect x="0" y="110" width="400" height="40"/><rect x="170" y="50" width="60" height="100"/><polygon points="165,52 200,0 235,52"/>
<rect x="110" y="75" width="36" height="75"/><polygon points="106,77 128,35 150,77"/>
<rect x="254" y="75" width="36" height="75"/><polygon points="250,77 272,35 294,77"/>
<rect x="50" y="95" width="28" height="55"/><polygon points="46,97 64,62 82,97"/>
<rect x="322" y="95" width="28" height="55"/><polygon points="318,97 336,62 354,97"/></g>
<g fill="#ffe9a8"><rect x="195" y="70" width="10" height="16" rx="5"/><rect x="123" y="92" width="8" height="12" rx="4"/><rect x="269" y="92" width="8" height="12" rx="4"/></g></svg>
<h1 id="title">✨ โหวตเดินแบบนักเรียน ✨</h1>
<div class="sub">เลือกดาวเด่นของเราได้ 1 คนนะ 👑</div>
<div id="app" class="msg">🌟 กำลังโหลด...</div>
<div class="ov" id="ov"><div class="md"><div class="ic" id="mi"></div><h3 id="mt"></h3><p id="mp"></p><div class="bt" id="mb"></div></div></div>
<script>
const FB = 'PASTE_FIREBASE_URL_HERE';   // เช่น https://xxx-default-rtdb.asia-southeast1.firebasedatabase.app
const R = new URLSearchParams(location.search).get('round');
const app = document.getElementById('app'), $ = id => document.getElementById(id);
let token, last = '', voted = null, cfgNow = null;

// ---------- popup น่ารักๆ ----------
function modal(icon, title, text, btns) {
  return new Promise(ok => {
    $('mi').textContent = icon; $('mt').textContent = title; $('mp').textContent = text || '';
    $('mb').innerHTML = '';
    btns.forEach((b, i) => { const e = document.createElement('button'); e.textContent = b.t; if (b.g) e.className = 'g';
      e.onclick = () => { $('ov').style.display = 'none'; ok(i); }; $('mb').appendChild(e); });
    $('ov').style.display = 'flex';
  });
}
function sparkle() { for (let i = 0; i < 16; i++) { const s = document.createElement('div'); s.className = 'sp';
  s.textContent = ['✨', '⭐', '💖', '🌟'][i % 4]; s.style.left = (8 + Math.random() * 84) + '%'; s.style.animationDelay = (Math.random() * .4) + 's';
  document.body.appendChild(s); setTimeout(() => s.remove(), 2200); } }

// ---------- token ฝังหลายที่ (กันหายตอนปิดแท็บ/ล้างบางส่วน) ----------
const idb = (m, v) => new Promise(res => { try { const r = indexedDB.open('vt', 1);
  r.onupgradeneeded = () => r.result.createObjectStore('s');
  r.onsuccess = () => { const tx = r.result.transaction('s', m === 'get' ? 'readonly' : 'readwrite'), s = tx.objectStore('s');
    if (m === 'get') { const q = s.get('t'); q.onsuccess = () => res(q.result); q.onerror = () => res(null); }
    else { s.put(v, 't'); tx.oncomplete = () => res(); } };
  r.onerror = () => res(null); } catch (e) { res(null); } });
async function getToken() {
  let t = null;
  try { t = localStorage.getItem('vt'); } catch (e) {}
  if (!t) { const m = document.cookie.match(/(?:^|; )vt=([^;]+)/); t = m && m[1]; }
  if (!t) t = await idb('get');
  if (!t) t = (crypto.randomUUID ? crypto.randomUUID() : Date.now() + '-' + Math.random().toString(36).slice(2));
  try { localStorage.setItem('vt', t); } catch (e) {}
  document.cookie = 'vt=' + t + ';max-age=31536000;path=/;SameSite=Lax';
  await idb('put', t); return t;
}

// ---------- แสดงผล ----------
const say = t => { app.className = 'msg'; app.textContent = t; };
function render(cfg) {
  if (!R) return say('🔍 ไม่พบรอบโหวต\nกรุณาสแกน QR ใหม่นะ');
  if (!cfg) return say('🌙 ยังไม่มีข้อมูลรอบนี้');
  $('title').textContent = '✨ ' + (cfg.name || ('รอบ ' + R)) + ' ✨';
  if (!cfg.open) return say('🌙 ยังไม่เปิดโหวต\nหรือปิดโหวตแล้วนะ');
  if (voted) return say('💖 ขอบคุณที่ร่วมโหวตนะ!\nรอบนี้คุณโหวตเรียบร้อยแล้ว ✨');
  app.className = ''; app.innerHTML = '';
  (cfg.candidates || []).forEach((c, i) => {
    const d = document.createElement('div'); d.className = 'c';
    d.innerHTML = '<div class="n"></div><span></span><button>⭐ โหวต</button>';
    d.children[0].textContent = i + 1; d.children[1].textContent = c.name;
    d.children[2].onclick = () => vote(c); app.appendChild(d);
  });
}
async function load() {
  if (FB.includes('PASTE')) return say('⚙️ ยังไม่ได้ใส่ลิงก์ Firebase\nในบรรทัด const FB ของไฟล์');
  if (!R) return render(null);
  try {
    const cfg = await (await fetch(FB + '/config/rounds/r' + R + '.json')).json();
    const sig = JSON.stringify(cfg); if (sig === last) return;
    if (cfg && cfg.open) voted = await (await fetch(FB + '/votes/r' + R + '/' + token + '.json')).json();  // ถามเซิร์ฟเวอร์ว่าเครื่องนี้โหวตแล้วหรือยัง
    last = sig; cfgNow = cfg; render(cfg);
  } catch (e) { say('☁️ เชื่อมต่อไม่ได้\nลองใหม่อีกครั้งนะ'); }
}
async function vote(c) {
  if (await modal('🌟', 'ยืนยันโหวตให้', c.name + '\nโหวตแล้วเปลี่ยนไม่ได้นะ', [{ t: 'ยกเลิก', g: 1 }, { t: '⭐ ยืนยัน' }]) !== 1) return;
  try {
    const r = await fetch(FB + '/votes/r' + R + '/' + token + '.json', { method: 'PUT', body: JSON.stringify(c.id) });
    if (r.ok) { voted = c.id; render(cfgNow); sparkle(); return modal('💖', 'โหวตสำเร็จ!', 'ขอบคุณที่ร่วมสนุกกับเรานะ', [{ t: 'ปิด' }]); }
    last = ''; await load();
    modal(voted ? '💖' : '🌙', voted ? 'โหวตไปแล้วนะ' : 'ปิดโหวตแล้ว', voted ? 'เครื่องนี้โหวตรอบนี้ไปแล้ว' : 'รอบนี้ปิดรับโหวตแล้ว', [{ t: 'ตกลง' }]);
  } catch (e) { modal('☁️', 'เชื่อมต่อไม่ได้', 'ลองกดโหวตใหม่อีกครั้งนะ', [{ t: 'ตกลง' }]); }
}
(async () => { token = await getToken(); load(); setInterval(load, 4000); })();
</script></body></html>
